import os
import heapq


def run_metro_navigator():
    map_file = "metro_map.txt"
    if not os.path.exists(map_file):
        print("Ошибка: Файл 'metro_map.txt' не найден!"); return

    graph = {}
    with open(map_file, "r", encoding="utf-8") as f:
        for line in f:
            if ":" not in line:
                continue
            label, body = line.strip().split(":", 1)
            if label.startswith("Пересадки"):
                for pair in body.split(","):
                    left, mins = pair.strip().split("(")
                    a, b = left.split("-")
                    mins = int(mins.replace(")", ""))
                    graph.setdefault(a.strip().lower(), list()).append((b.strip().lower(), mins, b.strip(), "Пеший переход"))
                    graph.setdefault(b.strip().lower(), list()).append((a.strip().lower(), mins, a.strip(), "Пеший переход"))
            else:
                parts = body.replace("(", "|").replace(")", "|").split("|")
                for i in range(0, len(parts) - 2, 2):
                    a, mins, b = parts[i].strip(), int(parts[i + 1]), parts[i + 2].strip()
                    graph.setdefault(a.lower(), list()).append((b.lower(), mins, b, label))
                    graph.setdefault(b.lower(), list()).append((a.lower(), mins, a, label))

    start = input("Станция отправления: ").strip().lower()
    goal = input("Станция назначения: ").strip().lower()
    if start not in graph or goal not in graph:
        print("Ошибка: Станция не найдена в базе данных."); return

    pq, best = [(0, start, [(start.title(), "Старт")])], {start: 0}
    while pq:
        mins, curr, path = heapq.heappop(pq)
        if curr == goal:
            lines_used = list()
            for _, tag in path[1:]:
                if tag != "Пеший переход" and (not lines_used or lines_used[-1] != tag):
                    lines_used.append(tag)
            print(f"\nВремя в пути  : {mins} мин.")
            print(f"Всего станций : {len(path)} (перегонов: {len(path) - 1})")
            print(f"Линии маршрута: {' -> '.join(lines_used)}")
            print("-" * 65)
            for st, tag in path:
                print(f"  {st:<26} | {tag}")
            return
        for nxt, travel, proper, tag in graph[curr]:
            if mins + travel < best.get(nxt, float("inf")):
                best[nxt] = mins + travel
                heapq.heappush(pq, (mins + travel, nxt, path + [(proper, tag)]))


if __name__ == "__main__":
    run_metro_navigator()

