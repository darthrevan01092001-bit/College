import os
import heapq


def run_metro_navigator():
    map_file = "metro_map.txt"
    if not os.path.exists(map_file):
        print("Error: 'metro_map.txt' not found!"); return

    graph = {}
    with open(map_file, "r", encoding="utf-8") as f:
        for line in f:
            if ":" not in line:
                continue
            label, body = line.strip().split(":", 1)
            if label.startswith("Transfers"):
                for pair in body.split(","):
                    left, mins = pair.strip().split("(")
                    a, b = left.split("-")
                    mins = int(mins.replace(")", ""))
                    graph.setdefault(a.strip().lower(), list()).append((b.strip().lower(), mins, b.strip(), "Walk Transfer"))
                    graph.setdefault(b.strip().lower(), list()).append((a.strip().lower(), mins, a.strip(), "Walk Transfer"))
            else:
                parts = body.replace("(", "|").replace(")", "|").split("|")
                for i in range(0, len(parts) - 2, 2):
                    a, mins, b = parts[i].strip(), int(parts[i + 1]), parts[i + 2].strip()
                    graph.setdefault(a.lower(), list()).append((b.lower(), mins, b, label))
                    graph.setdefault(b.lower(), list()).append((a.lower(), mins, a, label))

    start = input("Departure station: ").strip().lower()
    goal = input("Destination station: ").strip().lower()
    if start not in graph or goal not in graph:
        print("Error: Station not found."); return

    pq, best = [(0, start, [(start.title(), "Start")])], {start: 0}
    while pq:
        mins, curr, path = heapq.heappop(pq)
        if curr == goal:
            lines_used = list()
            for _, tag in path[1:]:
                if tag != "Walk Transfer" and (not lines_used or lines_used[-1] != tag):
                    lines_used.append(tag)
            print(f"\nTime: {mins} min | Stations: {len(path)} | Lines: {' -> '.join(lines_used)}")
            for st, tag in path:
                print(f"  {st:<26} | {tag}")
            return
        for nxt, travel, proper, tag in graph[curr]:
            if mins + travel < best.get(nxt, float("inf")):
                best[nxt] = mins + travel
                heapq.heappush(pq, (mins + travel, nxt, path + [(proper, tag)]))


if __name__ == "__main__":
    run_metro_navigator()



