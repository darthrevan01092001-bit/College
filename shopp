import os
import random


def run_batch_billing():
    items_file = "items.txt"
    prices_file = "prices.txt"

    if not os.path.exists(items_file) or not os.path.exists(prices_file):
        print("Error: Ensure both 'items.txt' and 'prices.txt' exist!"); return

    database = {}

    # 1. Parse Data Streams into Memory
    with open(items_file, "r", encoding="utf-8") as f:
        for line in f:
            if line.strip():
                parts = line.strip().rsplit(maxsplit=1)
                if len(parts) == 2:
                    database[parts[1].strip()] = {"name": parts[0]}

    with open(prices_file, "r", encoding="utf-8") as f:
        for line in f:
            if "=" in line:
                serial, price_str = line.split("=")
                serial = serial.strip()
                if serial in database:
                    database[serial]["price"] = float(price_str.strip())

    # 2. Get User Age Once
    print("\n=== BATCH PROCESSING CHECKOUT INITIALIZED ===")
    try:
        user_age = int(input("Enter buyer age: "))
    except ValueError:
        print("❌ System Exception: Invalid numeric entry."); return

    # 3. Dynamic Environmental Variables
    days = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
    rolled_day = random.choice(days)
    discount_rate = 0.20 if rolled_day == "Friday" else (0.15 if rolled_day in ["Saturday", "Sunday"] else 0.00)

    # 4. Input Processing (Handles both "J6K K7L" and "J6K, K7L")
    raw_input = input("Enter serial numbers (separated by spaces or commas): ")
    # Replace all commas with spaces, then split into a clean list of clean strings
    requested_serials = raw_input.replace(",", " ").split()

    cart = []
    
    # 5. Process the Parsed Input List
    for serial in requested_serials:
        if serial not in database:
            print(f"⚠️ Warning: Serial '{serial}' not found in registry. Skipping.")
            continue

        target = database[serial]
        age_req = 18 if "cola" in target["name"] or "pepper" in target["name"] else 0

        if user_age < age_req:
            print(f"❌ Access Denied: {target['name'].upper()} requires age {age_req}+. Skipping.")
            continue

        cart.append((serial, target))

    if not cart:
        print("🛒 No valid items added. Transaction cancelled."); return

    # 6. Combined Final Receipt Calculation
    print(f"\n{'='*15} TRANSACTION RECEIPT {'='*15}")
    print(f"Current Day Mode:     {rolled_day}")
    print(f"Applied Promo Rate:   {discount_rate * 100:.0f}%")
    print("-" * 49)

    subtotal = 0.0
    for serial, item in cart:
        print(f"- {item['name'].title():<28} [{serial}] : ${item['price']:.2f}")
        subtotal += item["price"]

    discount_amount = subtotal * discount_rate
    final_bill = subtotal - discount_amount

    print("-" * 49)
    print(f"Subtotal:             ${subtotal:.2f}")
    print(f"Total Discount:      -${discount_amount:.2f}")
    print(f"Final Account Bill:   ${final_bill:.2f}")
    print(f"{'='*49}\n")


if __name__ == "__main__":
    run_batch_billing()









