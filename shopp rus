import os
import random


def run_batch_billing():
    # Файлы баз данных
    items_file = "items.txt"
    prices_file = "prices.txt"

    # 1. Защитная проверка существования файлов на диске
    if not os.path.exists(items_file) or not os.path.exists(prices_file):
        print("Ошибка: Убедитесь, что файлы 'items.txt' и 'prices.txt' находятся в папке скрипта!"); return

    database = {}

    # 2. Чтение файла 1: Связывание русских серийных кодов с названиями
    with open(items_file, "r", encoding="utf-8") as f:
        for line in f:
            if line.strip():
                parts = line.strip().rsplit(maxsplit=1)
                if len(parts) == 2:
                    name, serial = parts[0], parts[1].strip()
                    database[serial] = {"name": name}

    # 3. Чтение файла 2: Привязка цен через поиск по кодам (игнорируя случайный порядок)
    with open(prices_file, "r", encoding="utf-8") as f:
        for line in f:
            if "=" in line:
                serial, price_str = line.split("=")
                serial = serial.strip()
                if serial in database:
                    database[serial]["price"] = float(price_str.strip())

    # 4. Ввод возраста покупателя (Выполняется один раз на всю сессию)
    print("\n=== ИНИЦИАЛИЗАЦИЯ ПАКЕТНОЙ КАССОВОЙ СЕССИИ ===")
    try:
        user_age = int(input("Введите возраст покупателя для верификации: "))
    except ValueError:
        print("❌ Системное исключение: Неверный числовой формат ввода."); return

    # 5. Генерация случайных системных условий дня
    days = ["Понедельник", "Вторник", "Среда", "Четверг", "Пятница", "Суббота", "Воскресенье"]
    rolled_day = random.choice(days)
    discount_rate = 0.20 if rolled_day == "Пятница" else (0.15 if rolled_day in ["Суббота", "Воскресенье"] else 0.00)

    # 6. Обработка ввода корзины серийных кодов
    raw_input = input("Введите серийные коды через пробел или запятую: ")
    requested_serials = raw_input.replace(",", " ").split()

    cart = []
    
    # 7. Фильтрация и валидация каждого запрошенного кода
    for serial in requested_serials:
        if serial not in database:
            print(f"⚠️ Предупреждение: Код '{serial}' не найден в реестре. Пропущено.")
            continue

        target = database[serial]
        # Проверка возрастного ценза: 18+ для газировок (кола, пеппер), для остального 0+
        age_req = 18 if "кола" in target["name"] or "пеппер" in target["name"] else 0

        if user_age < age_req:
            print(f"❌ Отказ в доступе: '{target['name'].upper()}' требует возраст {age_req}+. Пропущено.")
            continue

        cart.append((serial, target))

    if not cart:
        print("🛒 В корзине нет валидных товаров. Транзакция отменена."); return

    # 8. Финальный расчет стоимостных метрик и печать чека
    print(f"\n{'='*15} ТОВАРНЫЙ ЧЕК ККМ {'='*15}")
    print(f"Текущий режим дня:     {rolled_day}")
    print(f"Примененная скидка:    {discount_rate * 100:.0f}%")
    print("-" * 48)

    subtotal = 0.0
    for serial, item in cart:
        print(f"- {item['name'].capitalize():<28} [{serial}] : {item['price']:.2f} руб.")
        subtotal += item["price"]

    discount_amount = subtotal * discount_rate
    final_bill = subtotal - discount_amount

    print("-" * 48)
    print(f"Промежуточный итог:    {subtotal:.2f} руб.")
    print(f"Сумма скидки:         -{discount_amount:.2f} руб.")
    print(f"ИТОГО К ОПЛАТЕ:        {final_bill:.2f} руб.")
    print(f"{'='*48}\n")


if __name__ == "__main__":
    run_batch_billing()







