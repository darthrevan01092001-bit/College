import random

def run_quiz():
    # 1. Загрузка общих вопросов и проверка размера пула
    try:
        with open("questions.txt", "r", encoding="utf-8") as q_file, open("answers.txt", "r", encoding="utf-8") as a_file:
            gen_pool = [(q.strip(), a.strip()) for q, a in zip(q_file, a_file) if q.strip()]
    except FileNotFoundError:
        print("Ошибка: Убедитесь, что файлы 'questions.txt' и 'answers.txt' находятся в одной папке со скриптом!"); return

    if len(gen_pool) < 80:
        print(f"Ошибка: В ваших файлах всего {len(gen_pool)} вопросов. Пожалуйста, добавьте как минимум до 80!"); return

    # 2. Выборка ровно 80 общих вопросов и генерация 20 математических задач
    quiz_pool = random.sample(gen_pool, 80)
    ops = ['+', '-', '*', '/']
    while len(quiz_pool) < 100:  # 80 общих + 20 математических = 100 всего
        num1, num2, op = random.randint(10, 99), random.randint(2, 9), random.choice(ops)
        if op == '/':
            num1 = random.randint(20, 99)
            q_text = f"Математика: Разделите {num1} на {num2}. Округлите до 1 знака после запятой:"
            ans_text = str(round(num1 / num2, 1))
        else:
            q_text = f"Математика: Сколько будет {num1} {op} {num2}?:"
            ans_text = str(eval(f"{num1}{op}{num2}"))
        quiz_pool.append((q_text, ans_text))

    # 3. Выборка ровно 20 вопросов для текущей игровой сессии
    quiz_session = random.sample(quiz_pool, 20)
    score = 0
    print("=== НАЧАЛО ТЕСТИРОВАНИЯ ИЗ 20 ВОПРОСОВ (Всего: 100 баллов) ===")

    # 4. Основной игровой цикл
    for i, (question, correct_answer) in enumerate(quiz_session, 1):
        print(f"\n[{i}/20] {question}")
        user_answer = input("Ваш ответ: ").strip().replace(",", ".")

        if user_answer.lower() == correct_answer.lower():
            print("✨ Правильно! (+5 баллов)")
            score += 5
        else:
            print(f"❌ Неверно. Правильный ответ: {correct_answer}")

    print(f"\n=== ТЕСТ ЗАВЕРШЕН ===\nВаш итоговый счет: {score} / 100 баллов")

if __name__ == "__main__":
    run_quiz()





